<Project>
  <PropertyGroup>
    <!-- Target Framework -->
    <TargetFramework>net481</TargetFramework>
    
    <!-- Language Version -->
    <LangVersion>7.3</LangVersion>
    
    <!-- Output Configuration -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    
    <!-- Assembly Information -->
    <AssemblyTitle>Sims4Tools</AssemblyTitle>
    <AssemblyCompany>Sims4Tools Contributors</AssemblyCompany>
    <AssemblyProduct>Sims4Tools</AssemblyProduct>
    <AssemblyCopyright>Copyright © Sims4Tools Contributors</AssemblyCopyright>
    
    <!-- Version -->
    <AssemblyVersion>0.4.4.0</AssemblyVersion>
    <FileVersion>0.4.4.0</FileVersion>
    
    <!-- Build Configuration -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    
    <!-- Cross-Platform Compatibility -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    
    <!-- Warnings and Errors -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningLevel>4</WarningLevel>
    
    <!-- NuGet -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>

  <!-- Conditional properties for different OS -->
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>
  
  <PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
    <DefineConstants>$(DefineConstants);UNIX</DefineConstants>
  </PropertyGroup>

  <!-- Common Package References -->
  <ItemGroup>
    <PackageReference Include="System.Memory" Version="4.5.4" Condition="'$(TargetFramework)' == 'net481'" />
  </ItemGroup>
</Project>
